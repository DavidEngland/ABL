@techReport{,
   abstract = {The stability functions for momentum and heat under a Richardson number formulation are derived from the nondimensional shear functions under a Monin-Obukhov formulation. The Prandtl number is also derived as a function of the Richardson number. Previously, this has been done only in a limited sense. Because the Richardson number formulation is expressed in closed form, iterative techniques are no longer needed in numerical models that use Monin-Obukhov similarity theory. This time-saving approach is made possible by deriving expressions for the friction velocity and temperature in terms of the Richardson-number-dependent stability functions. In addition, the Richardson number approximation in the lowest layer is made to depend explicitly upon the surface roughness.},
   author = {David E England and Richard T Mcnider},
   title = {STABILITY FUNCTIONS BASED UPON SHEAR FUNCTIONS}
}
@techReport{,
   abstract = {Since turbulent mixing often becomes discontinuous and intermittent in the stable stratiied boundary layer, so do nighttime CO uxes observed over an ecosystem. The friction velocity correction (u * correction) is applied to nighttime CO uxes measured with the eddy covariance technique for evaluating the ecosystem respiration rate. However, the applicability of this procedure is uncertain in intermittently turbulent conditions as the friction velocity oscillates between extremely large and small values. We used a simple numerical model to simulate intermittent mixing in the stable boundary layer and analysed the characteristics of intermittent nighttime CO uxes. We then examined the applicability of the u * correction in intermittently turbulent conditions. The simulation results showed alternations between highly turbulent periods with large positive CO uxes and quiescent periods with small positive and zero CO uxes. With increasing the geostrophic wind in the range of .. m s-to .. m s-, the magnitude of upward intermittent CO uxes as well as the time intervals between intermittent turbulent periods became smaller. A non-linear dependency of the upward CO uxes on the surface temperature was not clear during intermittently turbulent periods. The uxes observed in conjunction with high u * values showed a better relationship with the surface temperature although use of such uxes in the u * correction procedure overestimated the ecosystem respiration rate: the u * corrected estimates of the respiration rate were twice as high as the ecosystem respiration rate. During ux events, CO storage uxes became large and negative. In such cases, the CO storage ux must be added to the CO ux for evaluating the ecosystem respiration rate using the u * correction procedure. () (J. Agric. Meteorol.) (():- ,},
   author = {Yukio Yasuda and Tsutomu Watanabe and Yoshikazu Ohtani and Yasuko Miioguchi},
   keywords = {CO ux,Friction velocity correction,Intermittent turbulence,Numerical model},
   title = {A Problem of Eddy CovarianceBased Evaluations of Ecosystem Respiration Rate Friction Velocity Correction in Intermittently Turbulent Conditions}
}
