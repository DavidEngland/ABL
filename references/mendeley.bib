@techReport{England2025,
   abstract = {The curvature of the gradient Richardson number Ri g with respect to the Monin-Obukhov stability parameter ζ = z/L provides fundamental insight into the nonlinear coupling between stratification and turbulent mixing in the atmospheric surface layer. We derive a compact analytical expression for ∂ 2 Ri g /∂ζ 2 in terms of logarithmic derivatives of the Monin-Obukhov stability functions ϕ m and ϕ h , introducing the neutral curvature invariant ∆ = α h β h − 2α m β m that governs the initial departure from linearity. We demonstrate that negative curvature (typ-ical in stable boundary layers) leads to systematic underestimation of near-surface stability on coarse vertical grids, producing excessive turbulent mixing. A grid-aware correction strategy preserving the neutral curvature 2∆ is outlined, with implications for improved parameterization of stable nocturnal and polar boundary layers.},
   author = {David E England},
   title = {Physical Interpretation of the Curvature of the Gradient Richardson Number in the Stable Atmospheric Boundary Layer},
   year = {2025}
}
