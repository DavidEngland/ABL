@article{Li2026,
   abstract = {In this paper, we introduce a skeletal finite element method (FEM) for the elliptic interface eigenvalue problem. We analyze the case involving curved interface. Due to the lack of commutativity of the projection operators on curved elements, an H 1-orthogonal projection is defined to achieve optimal error estimates for the eigenvalues. Furthermore, for straight interface, we rigorously prove the lower bound property for eigenvalues of the numerical scheme. Finally, we present multiple sets of numerical experiments to verify the accuracy of the numerical scheme, including cases with straight interface and curved interface.},
   author = {Shusheng Li and Hehu Xie and Qilong Zhai},
   doi = {10.1016/j.cnsns.2026.109916},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Elliptic interface eigenvalue problem,Error estimates,Lower bounds,Skeletal finite element method},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A skeletal finite element method for elliptic interface eigenvalue problems},
   volume = {159},
   year = {2026}
}
@article{Li2026,
   abstract = {In this paper, a finite element method based on total pressure is developed to simulate the Stokes–Dual–Porosity–Poroelasticity model for coupled free flow and dual porosity poroelastic media flow. The model employs the Stokes equations to describe free flow within conduits and utilizes a dual–porosity poroelasticity system to characterize the deformation and seepage processes in reservoirs containing both matrix and micro-fractures. These two regions are coupled through a set of interface conditions. To overcome numerical locking, a total pressure variable is introduced, leading to a four-field variational formulation based on displacement, total pressure, matrix pressure and micro-fracture pressure. Using the finite element method for spatial discretization, a semi-discrete scheme is first constructed and its well-posedness is proved. Then, a fully discrete scheme is established via the backward Euler method for time discretization, and corresponding error estimates are provided. Numerical experiments verify the theoretical convergence rate of the method, and its effectiveness is demonstrated through two- and three-dimensional channel filtration problems.},
   author = {Dengkui Li and Chong Wang and Rui Li and Zhangxin Chen},
   doi = {10.1016/j.cnsns.2026.109901},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Dual–Porosity–Poroelasticity model,Error estimates,Free flow,Total pressure},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A Stokes–Dual–Porosity–Poroelasticity Model and finite element method for coupling free flow and dual porosity poroelastic media flow},
   volume = {159},
   year = {2026}
}
@article{Zhu2026,
   abstract = {This paper introduces a novel cover-based framework for analyzing topological complexity in hyperspace dynamical systems (2X, 2T) induced by a base system ( X, T ). We develop equivalent formulations of both topological entropy and metric mean dimension using open covers of X , which significantly simplifies computations and provides a unified perspective on complexity amplification. Our main contributions are threefold: (1) We establish cover-based definitions that are equivalent to classical metric formulations but more tractable for hyperspace analysis; (2) Using this framework, we prove that if the base system has positive metric mean dimension, then the induced hyperspace system necessarily has infinite metric mean dimension; (3) We recover and simplify the corresponding result for topological entropy, demonstrating that our approach unifies the treatment of both finite and infinite complexity regimes. The cover-based method reveals the common mechanism behind complexity explosion and offers a constructive tool for studying induced systems. Several examples illustrate the effectiveness of our framework, including computations for symbolic systems and sparse coding models. Our results deepen the understanding of how structural complexity propagates from base systems to their hyperspace extensions, with implications for information encoding and high-dimensional dynamics.},
   author = {Bin Zhu and Xian Wang},
   doi = {10.1016/j.cnsns.2026.109887},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Hyperspace,Metric mean dimension,Open cover,Topological entropy},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A cover-based framework for topological complexity in hyperspace dynamical systems},
   volume = {159},
   year = {2026}
}
@article{Ghosh2026,
   abstract = {This paper presents a finite element model for the analysis of crack-tip fields in a transversely isotropic strain-limiting elastic body. A nonlinear constitutive relationship between stress and linearized strain characterizes the material response. This algebraically nonlinear relationship is critical as it mitigates the physically inconsistent strain singularities that arise at crack tips. These strain-limiting relationships ensure that strains remain bounded near the crack tip, representing a significant advancement in the formulation of boundary value problems (BVPs) within the context of first-order approximate constitutive models. For a transversely isotropic elastic material containing a crack, the equilibrium equation, derived from the balance of linear momentum under a specified nonlinear constitutive relation, is shown to reduce to a second-order, vector-valued, quasilinear elliptic BVP. A robust numerical method is introduced, integrating Picard-type linearization with a continuous Galerkin-type finite element procedure for spatial discretization. Numerical results, obtained for tensile loading conditions and two distinct material fiber orientations, illustrate that the evolution of crack-tip strains occurs significantly slower than that of the stresses. However, the strain-energy density is most pronounced near the crack tip, consistent with observations from linearized elasticity theory. It is demonstrated that the framework investigated herein can serve as a basis for formulating physically meaningful and mathematically well-defined BVPs, which are essential for exploring crack evolution, damage, nucleation, and failure in anisotropic strain-limiting elastic materials.},
   author = {Saugata Ghosh and Dambaru Bhatta and S. M. Mallikarjunaiah},
   doi = {10.1016/j.cnsns.2026.109868},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Finite element method,Plane-strain fracture,Strain-limiting theories of elasticity,,Transversely isotropic},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A finite element model to analyze crack-tip fields in a transversely isotropic strain-limiting elastic solid},
   volume = {159},
   year = {2026}
}
@article{Li2026,
   abstract = {In this paper, we propose a positivity-preserving multiscale method for plasma simulation based on a novel temporally second-order unified gas-kinetic scheme (UGKS). The Vlasov-BGK equation is decomposed into two substeps–the transport-collision part and the acceleration part–within a second-order Strang-splitting framework. The transport-collision subproblem is solved by the proposed temporally second-order positivity-preserving UGKS, while the acceleration subproblem is handled by a positivity-preserving collisionless solver, so that the overall temporal accuracy of the coupled scheme is maintained at second order. The key contribution of this work lies in reformulating the transport-collision equation and establishing a rigorous equivalence between the finite-volume UGKS update and a time-evolution integral representation, which enables the construction of a temporally second-order positivity-preserving scheme without introducing restrictive time-step constraints. Both the positivity-preserving and asymptotic-preserving properties of the proposed method are established analytically. A series of numerical experiments, including Landau damping and two-stream instability tests, are performed to demonstrate the accuracy, robustness, and multiscale capability of the method.},
   author = {Yingying Li and Yi Wang and Shuang Tan and Guoxi Ni},
   doi = {10.1016/j.cnsns.2026.109826},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Asymptotic-preserving property,Plasma simulation,Positivity-preserving property,Unified gas-kinetic scheme},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A temporally second-order positivity-preserving unified gas-kinetic scheme for plasma simulation},
   volume = {159},
   year = {2026}
}
@article{Hussain2026,
   abstract = {This study develops a continuous-time stochastic differential game to model the strategic interactions between multiple heterogeneous insiders and a risk-neutral market maker under a fixed trading deadline. Unlike standard Kyle-type models, which assume constant liquidity or infinite horizons, we endogenise the price impact parameter through a Rational Expectations Equilibrium (REE), formally deriving it via Kalman-Bucy filtering. By solving a coupled system of Forward-Backward Stochastic Differential Equations (FBSDEs), we characterize the equilibrium trading strategies and market dynamics. Our numerical results yield three critical insights. First, market liquidity is inherently time-varying; the price impact parameter declines systematically as the market maker resolves uncertainty, refuting the validity of static liquidity assumptions in dynamic settings. Second, intensified competition accelerates price discovery, with the transition from a duopoly to a competitive oligopoly (N=4) reducing terminal pricing errors by approximately 30%. Third, we identify a survival of the fittest mechanism driven by risk aversion: insiders with lower risk aversion trade aggressively early in the horizon to capture the majority of informational rents, effectively crowding out risk averse competitors. These findings provide a theoretical basis for the hump shaped volume patterns observed in empirical markets and offer actionable implications for regulatory surveillance of information leakage.},
   author = {Sayed Akif Hussain and Asma Komal and Faiza Saleem and Syed Amer Hussain and Syed Atif Hussain and Chen Qiu-Shi and Kumail Raza},
   doi = {10.1016/j.cnsns.2026.109824},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Endogenous liquidity,Forward-backward stochastic differential equations,Insider trading,Kalman filtering,Market efficiency,Stochastic differential game},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A theoretical analysis of information leakage and market efficiency under forecast announcements},
   volume = {159},
   year = {2026}
}
@article{Lin2026,
   abstract = {Through multiple timescale Chapman–Enskog expansion analysis, a flux solver based on the discrete Boltzmann method (DBM) is developed for compressible flows with both hydrodynamic and thermodynamic nonequilibrium effects. Unlike traditional DBM approaches relying on discrete Boltzmann equations, the proposed flux solver adopts an enhanced framework that significantly reduces the number of kinetic equations while maintaining high computational efficiency and robust numerical stability, as demonstrated through von Neumann stability analysis. Compared to the lattice Boltzmann flux solver, the DBM-based flux solver offers distinct advantages: it eliminates the need for interpolation to compute physical quantities at cell interfaces and avoids recalculating discrete equilibrium distribution functions before and after each time step. Furthermore, in contrast to conventional macroscopic computational fluid dynamics based on the Navier–Stokes equations, this solver leverages simplified governing equations to effectively capture both hydrodynamic and thermodynamic nonequilibrium effects. The accuracy and performance of the solver are validated through five benchmark cases: shock wave, Sod shock tube, sound wave, thermal Couette flow, and Taylor–Green vortex, demonstrating its potential for efficiently solving complex fluid problems.},
   author = {Chuandong Lin and Chang Shu},
   doi = {10.1016/j.cnsns.2026.109905},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Compressible flow,Discrete Boltzmann method,Flux solver,Nonequilibrium effect},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A flux solver based on discrete Boltzmann method and its application to compressible flows},
   volume = {159},
   year = {2026}
}
@article{Hao2026,
   abstract = {This paper presents a computational framework for linear elasticity problems with random interfaces. By integrating shape calculus, low-rank approximation, and the weak Galerkin finite element method, the framework efficiently quantifies solution statistics. We first provide a rigorous characterization of random interfaces under C 2,1-regularity and derive the governing equations for shape derivatives. A novel hybrid algorithm is then proposed, combining weak Galerkin method with a pivoted Cholesky decomposition to achieve superior computational efficiency in variance estimation over conventional Monte Carlo methods at equivalent accuracy. We rigorously derive a priori error estimates, establishing discretization errors of order O(h2) with respect to the mesh size h , random errors in expectation of order O(δ2), and in variance of order O(δ3), where δ denotes the amplitude of the random interface perturbation. Numerical experiments in Rd(d=2,3) confirm the method’s effectiveness and robustness.},
   author = {Yongle Hao and Fuchang Huo and Kai Zhang},
   doi = {10.1016/j.cnsns.2026.109895},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Elasticity problem,Low-rank approximation,Random interface,Shape derivative},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A low-rank approximation method for linear elasticity with random interfaces},
   volume = {159},
   year = {2026}
}
@article{Fritz2026,
   abstract = {We study a time-fractional Fisher–KPP equation involving a Riemann–Liouville fractional derivative acting on the diffusion term, as derived by Angstmann and Henry (Entropy, 22:1035, 2020). The model captures memory effects in diffusive population dynamics and serves as a framework for tumor growth modeling. We first establish local well-posedness of weak solutions. The analysis combines a Galerkin approximation with a refined a priori estimate based on a Bihari–Henry–Gronwall inequality, addressing the nonlinear coupling between the fractional diffusion and the reaction term. For small initial data, we further prove global well-posedness and asymptotic stability. A numerical method based on a nonuniform convolution quadrature scheme is then proposed and validated. Simulations demonstrate distinct dynamical behaviors compared to conventional formulations, emphasizing the physical consistency of the present model in describing tumor progression.},
   author = {Marvin Fritz and Nikos I. Kavallaris},
   doi = {10.1016/j.cnsns.2026.109911},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Fractional diffusion,Galerkin approximation,Nonlinear science,Nonuniform convolution quadrature scheme,Numerical simulation,Time-fractional Fisher–KPP equation,Well-posedness},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A time-fractional Fisher–KPP equation for tumor growth: Analysis and numerical simulation},
   volume = {159},
   year = {2026}
}
@article{Zheng2026,
   abstract = {The quasi-periodic (QP) solutions of nonlinear systems lack a fixed motion period, which makes their solution and stability analysis particularly challenging. This paper proposes a novel two-step discretization approach for solving the QP responses, based on the fundamental idea of variable separation. This approach first transforms the QP solution of the original system into the periodic solution of a discretized system, allowing the subsequent application of existing methods for periodic responses. Specifically in the first step, two different discretization schemes, including the Fourier and difference discretization schemes, are introduced to achieve the transformation into a discretized periodic system. Notably, in the Fourier discretization scheme, a time-domain balancing technique is adopted, which not only effectively eliminates the need for mathematical derivation and symbolic computation of generalized harmonic coefficients but also avoids program switching when the response transitions between periodic and QP solutions. Then in the second step, the shooting method is employed to solve the discretized periodic system with enhanced efficiency and accuracy, which directly yields the monodromy matrix for stability analysis. To demonstrate the effectiveness of the proposed approach, two representative nonlinear systems with QP solutions are analyzed, and the impacts of different discretization schemes on solution accuracy and stability results are discussed.},
   author = {Zechang Zheng and Loic Salles and Yanmao Chen and Zhongrong Lu and Jike Liu and Li Wang},
   doi = {10.1016/j.cnsns.2026.109939},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Finite difference discretization,Fourier discretization,Nonlinear system,Quasi-periodic solution,Stability analysis},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A two-step discretization framework bridging quasi-periodic and periodic solutions in nonlinear dynamics},
   volume = {159},
   year = {2026}
}
@article{Sabbar2026,
   abstract = {We develop a stage structured epidemic model with biological progression and we study a stochastic counterpart driven by Lévy jumps. Extending our previous study with a single jump driver, we now allow independent jump inputs across the main mechanisms, so shocks to contact and transmission need not coincide with shocks to progression or removal. Our principal result is a set of extinction conditions that are sharper than those available for common shock formulations. The analysis blends Lyapunov drift with generators that include independent compensators, together with comparison arguments that bound multi stage trajectories. We provide refined hypotheses and a detailed comparison with prior investigations. The framework remains transparent for inference and well suited to policy questions in which the timing of detection and care is decisive.},
   author = {Yassine Sabbar},
   doi = {10.1016/j.cnsns.2026.109908},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Extinction conditions,HIV/AIDS,Lévy jumps,Stage-structured progression,Stochastic epidemic modeling},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {New improvement of extinction conditions for a stochastic chain-structured HIV model with stage progression and independent jumps},
   volume = {159},
   year = {2026}
}
@article{Feng2026,
   abstract = {Conventional physics-informed neural networks (PINN) often suffer from gradient imbalance, unstable convergence, and high sensitivity to noise when solving partial differential equations (PDEs) due to the presence of multiple training constraints. To address these issues, this work proposes an Adaptive Piecewise-Weighted PINN (APW-PINN) based on probabilistic modeling. The method unifies the negative log-likelihoods of Gaussian and Laplace distributions through the piecewise structure of Smooth L1 loss, forming a new adaptive loss function. Meanwhile, the noise scale parameter σ is learned during training, enabling the model to smoothly switch between quadratic and linear penalty regimes and to adaptively characterize the residual distribution. Theoretical analysis shows that the proposed piecewise loss provides adaptive and bounded gradient weights across different error scales, effectively alleviating gradient imbalance among multiple loss terms and suppressing optimization oscillations caused by high-frequency structures or noise perturbations. In numerical experiments, we systematically evaluate the performance of APW-PINN on several representative classes of PDEs, including regular and resonant two-soliton interactions of the Boussinesq equation, the 2D Helmholtz equation, and the nonlinear Klein-Gordon equation. The results show that APW-PINN outperforms conventional PINN and its single-distribution variants (PINN-G and PINN-L) in convergence efficiency, solution accuracy, and noise robustness, benefiting from its interpretable probabilistic piecewise weighting mechanism. Moreover, in the parameter identification task for the Boussinesq equation, APW-PINN maintains parameter errors within 1% even under 10% noise, further confirming its outstanding robustness and generalization capability.},
   author = {Zixuan Feng and Chuanzhong Li and Huijuan Zhou},
   doi = {10.1016/j.cnsns.2026.109874},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Adaptive loss function,Forward and inverse PDEs problems,Physics-informed neural networks (PINN),Piecewise-weighted strategy,Probabilistic weighting},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {An adaptive piecewise-weighted loss strategy for improving physics-informed neural networks in solving PDEs},
   volume = {159},
   year = {2026}
}
@article{Sun2026,
   abstract = {In this paper, we construct a MAC method for the Stokes and nonlinear Darcy-Forchheimer problems coupled with the Beavers-Joseph-Saffman conditions on nonuniform staggered grids. The stability of the MAC scheme for both velocity and pressure has been established by the discrete inf-sup condition. Second-order L 2-norm error estimates for both velocity and pressure are derived on nonuniform rectangular grids. For the Stokes velocity, we further obtain second-order superconvergence for some H 1-norm terms, with the remaining terms achieving this rate on uniform grids. Numerical experiments confirm consistency between the method’s convergence rates and the theoretical analysis.},
   author = {Yue Sun and Chunyan Niu},
   doi = {10.1016/j.cnsns.2026.109890},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Coupled Stokes-Darcy-Forchheimer equations,MAC scheme,Stability,Superconvergence},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A MAC finite difference method for coupled Stokes-Darcy-Forchheimer model on nonuniform grids},
   volume = {159},
   year = {2026}
}
@article{Luo2026,
   abstract = {The affine formation control problem considering full-state error constrained, actuator saturation, and unknown disturbances of multiple stratospheric airships is investigated in this paper. To achieve the objective of formation reconfiguration without global knowledge, the affine transformation is used to generate the desired configuration. In particular, by establishing the algebraic relationship between the stress state and formation error, the desired attitude configuration of an airship satisfying zero-sideslip flight conditions is derived. Based on the backstepping method, an affine formation control algorithm ensuring that both the position and attitude of the airships are restricted by formation error constraints is proposed. Barrier Lyapunov functions are employed to satisfy the full-state error constraint requirement in each design step. Besides, the auxiliary system is designed to compensate for actuator saturation. Adaptive laws are developed to handle the unknown terms which are composed of unknown external disturbances and unmodeled dynamics. Finally, the numerical simulations are conducted to provide evidence for the efficacy and superiority of the affine formation control algorithm proposed in this paper.},
   author = {Xinting Luo and Ming Zhu and Tian Chen and Zewei Zheng},
   doi = {10.1016/j.cnsns.2026.109859},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Affine formation maneuvering control,Full-state error constraints,Multiple stratospheric airships},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Affine formation maneuvering control for full-state error constrained and actuator saturation of multiple stratospheric airships},
   volume = {159},
   year = {2026}
}
@article{Katende2026,
   abstract = {We present a unified operator-theoretic framework for stability and consistency in Physics-Informed Neural Networks. The analysis is formulated through coercivity, variational structure, and Sobolev regularity, and yields explicit non-asymptotic bounds linking empirical residual control to solution accuracy. We show that residual decay under uniform Sobolev bounds enforces convergence to the exact PDE solution in variational and uniform norms, independently of optimization idealization. Deterministic perturbation bounds quantify sensitivity of the composite PINN loss to output deviations, while McDiarmid-type concentration inequalities provide finite-sample generalization guarantees. A unified error decomposition separates approximation error, residual consistency, and perturbation effects. Numerical experiments across elliptic, parabolic, and nonlinear equations illustrate the theoretical mechanisms. The results identify operator coercivity, activation smoothness, and admissible sampling as structural conditions supporting stable and reliable residual-based learning.},
   author = {Ronald Katende},
   doi = {10.1016/j.cnsns.2026.109909},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Coercive operators,Concentration inequalities,Generalization bounds,Operator theory,Physics-Informed neural networks,Residual minimization,Sobolev regularity,Stability analysis,Variational methods},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Non-asymptotic stability and consistency guarantees for physics-informed neural networks via coercive operator analysis},
   volume = {159},
   year = {2026}
}
@article{Mi2026,
   abstract = {In this paper, we propose a deep learning-based node importance identification method that aims to improve the accuracy and robustness of node importance assessment in complex networks. We provide a comprehensive portrayal of node attributes at multiple levels: using neighbourhood degree to reflect the microstructural characteristics of nodes, employing fuzzy global dimension to measure the global attributes of nodes, and extracting the community attributes of nodes through local dominance-based community detection. These features complement each other and significantly improve the accuracy of the model. In order to construct a stable input representation, we extract the local topology of nodes through breadth-first search while considering node degree. In terms of model design, inspired by graph convolutional networks, we consider the node importance identification problem as a regression problem, innovatively combine convolutional block attention module (CBAM) with Densenet, and introduce a multiscale convolutional module (CBMK) to enhance the model’s performance and generalisation. Densenet effectively achieves information transfer and gradient optimisation through its densely connected structure, which is particularly suitable for dealing with complex and highly correlated node information; the CBAM module focuses on the most relevant features through the attention mechanism, which improves the accuracy of the node importance discrimination; the CBMK module fuses the local features of different scales through the multiscale convolutional operation, which enhances the model’s ability to comprehensively capture the network structure. capturing ability. Experimental results show that our method performs well in 15 real complex networks from various domains, and especially shows stable performance in low-connected and sparse networks as well.},
   author = {Yujia Mi and Aijing Lin},
   doi = {10.1016/j.cnsns.2026.109907},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Attention mechanisms,Community detection,DenseNet,Fuzzy fractal dimension,Node importance recognition},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Node importance recognition by neural networks based on feature integration},
   volume = {159},
   year = {2026}
}
@article{Ye2026,
   abstract = {This study investigates the fixed-time stability (FxTS) and predefined-time stability (PTS) of impulsive systems with discontinuous right-hand sides. Leveraging the hyperbolic-tangent function and logistic function, we establish novel FxTS criteria for such systems. By employing time-varying differential inequalities and exploiting the intrinsic properties of these two functions, we derive analytical estimates for the FxTS settling-time. Furthermore, we develop PTS criteria through the construction of innovative integral inequalities. Notably, our proposed criteria relax the conventional requirement of negative definiteness for the derivative of the Lyapunov function, and these results extend the previous results significantly. Additionally, using the framework of the average impulsive interval, we systematically examine the influence of both stabilizing and destabilizing impulses on the system’s FxTS and PTS properties. Finally, numerical examples and simulation results demonstrate the efficacy of our proposed methodology, highlighting its superior applicability compared to conventional approaches.},
   author = {Xiaolong Ye and Dongshu Wang and Longkun Tang},
   doi = {10.1016/j.cnsns.2026.109933},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Differential inclusions,Fixed-time stability,Impulsive system,Lyapunov method,Predefined-time stability},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Novel fixed/predefined-time stability analysis of discontinuous impulsive systems},
   volume = {159},
   year = {2026}
}
@article{Wang2026,
   abstract = {An observer-based practical prescribed-time consensus tracking control is proposed for uncertain multiagent systems subject to disturbances. Firstly, an improved practical prescribed-time stability strategy is established, which ensures the smoothness of the controller. Based on it, a practical prescribed-time distributed observer is further constructed, and then the information of the leader signal can be reconstructed. Moreover, an estimation strategy is developed to estimate the external disturbance and the derivative of the virtual control law simultaneously. Meanwhile, with the aid of a scaling function, a prescribed performance control protocol is investigated. By applying the proposed method, practical prescribed-time consensus of uncertain multiagent systems is realized. Finally, two simulation experiments are performed to verify the performance of the presented prescribed-time control method.},
   author = {Jianhui Wang and Jiarui Liu and Zikai Hu and Hai Lin and Kairui Chen and Dachang Zhu},
   doi = {10.1016/j.cnsns.2026.109928},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Consensus tracking control,Distributed observer,,Multiagent systems,Prescribed-time control},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Observer -based prescribed-time consensus tracking control for uncertain multiagent systems},
   volume = {159},
   year = {2026}
}
@article{Gao2026,
   abstract = {This article aims to reveal the mechanisms governing the birth of mixed-mode oscillations (MMOs) and relaxation oscillations (ROs) in a ENSO model, which is a 3-dimensional, three-timescale system. It is found that the small amplitude oscillations (SAOs) of MMOs in this model can be generated through canard mechanism associated with folded nodes and delayed Hopf bifurcation (DHB) as well as their interactions. The folded node and the DHB point can be perturbed from a canard-delayed Hopf (CDH) singularity, which becomes a folded saddle-node (FSN) II singularity by varying the control parameter. Also we find that MMOs can transit to ROs under variation of the control parameter. Numerical simulations are performed to verify all the theoretical predictions.},
   author = {Chanchan Gao and Jianhe Shen},
   doi = {10.1016/j.cnsns.2026.109897},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {CDH singularity,DHB point,ENSO model,FSN-II singularity,MMOs},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Analysis of interacting local oscillatory mechanisms in a three-timescale ENSO model},
   volume = {159},
   year = {2026}
}
@article{Wang2026,
   abstract = {This paper investigates a linear quadratic optimal control problem of uncertain fractional switched systems based on uncertainty theory. The optimality equation for an equivalent integer-order optimal control model is derived, and the problem is solved in two stages. In the first stage, the switching instants are fixed, and a conventional optimal control problem is solved using a dynamic programming approach. In the second stage, the differential evolution algorithm is employed to solve the corresponding optimization problem. As an application, a glucose-insulin optimal control problem is given, and numerical experiments are carried out to demonstrate the effectiveness of the proposed two-stage algorithm.},
   author = {Zhiwei Wang and Yuanguo Zhu},
   doi = {10.1016/j.cnsns.2026.109900},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Differential evolution algorithm,Glucose-insulin model,Linear quadratic control,Uncertain fractional switched systems,Uncertainty theory},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Optimal control method for uncertain fractional switched systems and application to glucose-insulin regulatory},
   volume = {159},
   year = {2026}
}
@article{Annouaoui2026,
   abstract = {This paper is devoted to investigate the reliability and the effectiveness of a shape optimization approach based on the shape derivative formula, involving Minkowski deformation of convex domains, introduced in [1], in solving shape optimization problems constrained by semi-linear partial differential equations (PDE). In this regard, let us mention that the performance of this approach in solving classical shape optimization problems constrained to linear state equations, governed by Laplace or Stokes operator, has recently been proved in [2, 3]. So we aim here to extend this shape optimization approach for solving a general class of shape optimization problems, notably those governed by a nonlinear PDE. To do that, we show first the well posedness of the considered shape optimization problem, then we derive the shape sensitivity analysis using the shape derivative approaches, based on the Minkowski deformation, under appropriate regularity assumptions on the nonlinear function. Finally, in order to show the efficiency of the resulting shape optimization gradient process, we propose its numerical comparative study with the same kind gradient process involving the Hadamard’s shape derivative using the deformation of domains by vector fields [4, 5, 6, 7], for solving shape optimization problems of minimizing quadratic cost functionals, constrained to various semi-linear PDE. This showed once again the effectiveness and the performance of the proposed approach, in solving this kind of problems, in terms of the accuracy of the solution and CPU time, compared to the classical approach.},
   author = {Taib Annouaoui and Abdelkrim Chakib and Ibrahim Khalil},
   doi = {10.1016/j.cnsns.2026.109869},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Comparative numerical study,Convex domains,Gradient algorithm,Semi-linear PDE,Shape derivative,Shape optimization,Support function},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {On a numerical sensitivity approach involving Minkowski deformations for solving shape optimization problems constrained by a semi-linear PDE},
   volume = {159},
   year = {2026}
}
@article{Dragu2026,
   abstract = {The present work addresses new classes of variational control problems with equality- and inequality-type constraints involving second- and third-order partial derivatives, developing a novel framework based on gradient-type variations. Concretely, by applying appropriate variational techniques, we establish the necessary conditions of optimality associated with the constrained cost functionals described by controlled curvilinear and multiple integrals, respectively. Moreover, under convexity or quasi-convexity assumptions, we formulate sufficient conditions for a feasible solution. To advance variational analysis and optimal control theory, we build a mathematical pipeline by considering gradient-type variation functions. Additionally, to highlight the practical significance of the main results, for each class of minimization problems, some illustrative numerical examples are presented.},
   author = {Marius Alin Dragu and Savin Treanţă},
   doi = {10.1016/j.cnsns.2026.109947},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {90C29,Gradient-type variations,Optimal control,Third-order PDEs 2020 MSC 5K10},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Optimal control models with gradient-type variations constrained by third-order PDEs},
   volume = {159},
   year = {2026}
}
