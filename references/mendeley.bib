}
@article{Liu2026,
   abstract = {This work concerns chaos and bifurcation of a three-dimensional (3D) Filippov system with three switching boundaries, two parallel and one transverse. The invisible-visible (I-V) fold point is found to act as a bridge between the chaotic attractors of the two subsystems, inducing a novel chaotic attractor, as observed by numerical simulations. The existence of various sliding periodic orbits on the transverse switching boundary is also observed. The classification of boundary equilibrium bifurcations (BEBs) is presented, and critical conditions for boundary pseudo-equilibrium bifurcations (BPEBs) arising from the transverse intersection of switching boundaries are derived. Conditions for the existence and stability of crossing limit cycles (CLCs) are established through analysis of the Poincaré map and validated by numerical simulations.},
   author = {Yongjian Liu and Zhaobing Peng and Wei Zhang},
   doi = {10.1016/j.cnsns.2026.109888},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Chaotic attractor,Crossing limit cycle,Filippov system,Multiple switching boundaries},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Bifurcations and chaos in a 3D Filippov system with multiple switching boundaries},
   volume = {159},
   year = {2026}
}
@article{Tolbukhin2026,
   abstract = {We present ORION (Optical Reconstructor for Interferometric Object Numerical Analysis), a computational framework for processing interferometric data of axisymmetric phase objects based on the Fourier-Abel-Hankel transform cycle. The method circumvents the numerical differentiation required in conventional direct Abel inversion through an integral transform approach that provides inherent noise resilience while maintaining negligible computational errors across diverse object scales and probing wavelengths. Implementation of optimized fast Fourier and Hankel transforms yields O(NlogN) computational complexity, enabling reconstruction times shorter than 50 ms for N=100. Systematic numerical validation demonstrates reconstruction errors below 1% for noise-free conditions and below 5% with 15% additive noise. Application to process the experimental laser interferometry data on discharge plasma channels achieves ≈ 3% accuracy in electron density reconstruction, establishing ORION as an efficient and robust tool for broad experimental applications in optical diagnostics.},
   author = {D. V. Tolbukhin and A. I. Khirianova and E. V. Parkevich},
   doi = {10.1016/j.cnsns.2026.109819},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Dielectric permittivity,Fourier-Abel-Hankel transform cycle,Geometrical optics approximation,Laser probing,Numerical simulations,Optical interferometry,Phase object reconstruction,Phase shift map},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {ORION: Optical reconstructor for interferometric object numerical analysis},
   volume = {159},
   year = {2026}
}
@article{Dai2026,
   abstract = {This paper is concerned with the periodic and solitary waves in a generalized delayed KP-MEW equation with two different distributed delays. The corresponding traveling wave equations are transformed into three-dimensional and four-dimensional dynamical systems, respectively, which can be regarded as singularly perturbed systems with a small perturbation parameter. Geometric singular perturbation theory provides an approach to reduce two high-dimensional dynamical systems to two planar near-Hamiltonian ones. For the general case, by applying bifurcation theory and studying the number of real zeros of Abelian integrals whose integrand and integral curve both have arbitrarily high-order terms, we respectively prove the existence and number of periodic wave solutions of the two equations with certain wave speeds. In addition, the upper and lower bounds of the wave speed of periodic waves are given. Furthermore, the existence of a solitary wave solution of the two equations for the general case is also established respectively by Melnikov’s method. Our results generalize previous findings and show that the existence and number of periodic and solitary wave solutions are not affected by distributed delays or the degree of the nonlinear term, but follow the wave speed selection principle.},
   author = {Yanfei Dai and Tianrui An and Minzhi Wei and Huiyang Zhang},
   doi = {10.1016/j.cnsns.2026.109876},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Abelian integrals,Delayed KP-MEW equation,Geometric singular perturbation theory,Periodic waves,Solitary waves},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Periodic and solitary waves in a generalized delayed KP-MEW equation with arbitrarily high-order nonlinearity},
   volume = {159},
   year = {2026}
}
@article{Konoplev2026,
   abstract = {We investigate stabilization of bumblebee-like flapping flight in planar x – z dynamics with wing-kinematics actuation, posing control as regulation of the velocity vector ( vx, vz, ω ) toward a forward-flight setpoint of 0.5 m s−1. A reinforcement learning (RL)-compatible environment integrates the rigid-body model at 5 ms steps and applies a localized vertical gust represented as an additional force with magnitude up to ∼ 10% of body weight, reproducing a planar-jet disturbance. Open-loop dynamics are unstable; the linear controller suppresses small perturbations rapidly within a narrow neighborhood of the operating point, with settling times comparable to those obtained in earlier biological experiments, but loses effectiveness for larger excursions. The discrete control-Lyapunov-function design expands the domain of attraction and maintains tracking through stronger gusts; the best performance is achieved by the hybrid model, which combines analytic structure with gradient-based updates, yielding a reproducible platform for benchmarking controllers for insect-scale flapping-wing micro air vehicles (MAVs) in unsteady flow.},
   author = {Pavel Konoplev and Artem Mikhaylov and Nikolay Efanov and Dmitry Kolomenskiy and Alexey A. Polilov and Evgeny Burnaev},
   doi = {10.1016/j.cnsns.2026.109839},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Control,Flapping-wing micro air vehicles,Hybrid models,Nonlinear mechanics},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Bumblebee flight stabilization using discrete control Lyapunov function-based controller in reinforcement learning environment},
   volume = {159},
   year = {2026}
}
@article{Goldsztein2026,
   abstract = {We carry out experiments, analytical studies and numerical simulations of a system of two coupled comparator-based relaxation oscillators. We analytically obtain the parameter regime of stable n:1 phase-locked solutions. These regions in the parameter space are known as Arnold tongues. These Arnold tongues agree with our experimental observations. The dynamics of the variables is described by a system of differential equations, but with discontinuities at discrete times. Given that this characteristic makes the analysis challenging, an unusual approach was developed and used. This new approach can also be adopted to study other systems of coupled oscillators, making this article valuable to the scientific community.},
   author = {Guillermo H. Goldsztein and Emma Behta and L. Q. English},
   doi = {10.1016/j.cnsns.2026.109860},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Arnold tongues,Coupled comparator-based,Coupled oscillators,Relaxation oscillators,Synchronization},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Phase-locking dynamics of bi-directionally coupled electronic relaxation oscillators},
   volume = {159},
   year = {2026}
}
@article{Jia2026,
   abstract = {This paper addresses the Lp stability-based pinning synchronization problem in multi-link coupling neural networks (MLCNNs) with time-varying transmission, leakage, distributed and coupling delays. Due to the existence of four types of time-varying delays, the model becomes more complex, if the traditional method of constructing Lyapunov-Krasovskii functionals (LKF) is used, the process of calculation will become more complex. Therefore, a simple and easy-to-implement pinning controller is first designed, which depends only on state error. Next, a direct method based on system solutions, without model transformation or LKF construction is proposed. Then, based on the proposed controller and direct method, two novel criteria of Lp stability-based pinning synchronization for MLCNNs with four kinds of time-varying delays and MLCNNs with coupling delays are derived, which only contains several simple scalar inequalities. In contrast to the existing approach, the method proposed in this paper greatly reduces the computational complexity. Finally, the feasible of the derived results are validated through two numerical examples. These findings are crucial for advancing secure communication, biological network modeling, and other applications. Notably, this is the first study to address Lp stability-based pinning synchronization in MLCNNs with four kinds of delays.},
   author = {Yunxiao Jia and Shasha Xiao},
   doi = {10.1016/j.cnsns.2026.109910},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Lp Stability-based pinning synchronization,Multi-link coupling neural networks,Time-varying coupling delays,Time-varying distributed delays,Time-varying leakage delays,Time-varying transmission delays},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Pinning synchronization conditions for multi-link coupling neural networks involving four types of time-varying delays: A result under the metric of Lp norm},
   volume = {159},
   year = {2026}
}
@article{Kinra2026,
   abstract = {In this article, we consider a novel version of three-dimensional (3D) globally modified Navier-Stokes (GMNS) system introduced by Caraballo et al., Adv. Nonlinear Stud., 6 (2006), 411–436 ([1]), which is very significant from the perspective of deterministic as well as stochastic partial differential equations. Our focus is on examining a stochastic version of the suggested 3D GMNS equations that are perturbed by an infinite-dimensional additive noise. We can consider a rough additive noise (Lebesgue space valued) with this model, which is not appropriate to consider with the system presented in Caraballo et al., Adv. Nonlinear Stud., 6 (2006), 411–436 ([1]). One of the technical problems associated with the rough noise is overcome by the use of the corresponding Cameron-Martin (or reproducing kernel Hilbert) space. This article aims to accomplish three objectives. Firstly, we establish the existence and uniqueness of weak solutions (in the analytic sense) of the underlying stochastic system using a Doss-Sussman transformation and a primary ingredient Minty-Browder technique. Secondly, we demonstrate the existence of random attractors for the underlying stochastic system in the natural space of square integrable divergence-free functions. Finally, we show the existence of an invariant measure for the underlying stochastic system for any viscosity coefficient ν > 0 and uniqueness of invariant measure for sufficiently large ν by using the exponential stability of solutions. A validation of the considered version of 3D GMNS equations has also been discussed in the appendix by establishing that the sequence of weak solutions of 3D GMNS equations converges to a weak solution of 3D Navier-Stokes equations as the modification parameter goes to infinity.},
   author = {K. Kinra and M. T. Mohan},
   doi = {10.1016/j.cnsns.2026.109877},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Random dynamics of solutions for three-dimensional stochastic globally modified Navier-Stokes equations on unbounded Poincaré domains},
   volume = {159},
   year = {2026}
}
@article{Meng2026,
   abstract = {The collective behavior in coupled systems is jointly governed by network topology and the response characteristics of nodal dynamics to environmental disturbances. Notably, the synchronization and stability are widely recognized to be closely related to multiple fields involving complex system analysis. This serves as a critical theoretical foundation for understanding the operational mechanisms of such systems and optimizing their functional performance. Under the framework of generalized Langevin dynamics, we propose the coupled system of fractional oscillators on Erdős-Rényi (ER) random networks, with a particular focus on the impact of frequency fluctuations (from external potential field disturbance), and examine how the interplay between network characteristics and individual dynamics shapes collective behaviors. Specifically, firstly, we employ random matrix theory to characterize the network’s structural randomness, and obtain the condition for stochastic asymptotic synchronization by leveraging the spectral properties of network Laplacians. Within the synchronization regime, subsequently, we analyze stochastic asymptotic stability and derive the analytical expression of stationary-state response for the mean field’s first moment. Finally, numerical simulations further validate the theoretical results, and explore the dependence of synchronization probability on the ER network characteristics (i.e., network size, reconnection probability), system memory-damping effects, and frequency fluctuations. Simulations also show that the stationary-state response exhibits pronounced non-monotonic behaviors driven by these combined effects: classical stochastic resonance (SR) emerges from the interaction between noise intensity and system memory, while modulation of damping under different noise levels induces generalized stochastic resonance (GSR). Likewise, the interplay among stochastic switching rate, inherent frequency, and external driving frequency generates strong non-monotonic effects, with low-frequency forcing enhancing GSR relative to the inherent frequency and high-frequency stochastic excitation giving rise to bona-fide resonance in the response to external driving. This study extends the theoretical framework for understanding the formation mechanisms of collective behaviors in complex coupled systems with structural randomness. Meanwhile, it also offers insights into enhancing the synchronization and stability of such systems, which are jointly regulated by network topology, individual dynamics, and environmental disturbance.},
   author = {Lin Meng and Xuerui Zhang and Lifeng Lin and Sihong Shi and Huiqi Wang},
   doi = {10.1016/j.cnsns.2026.109919},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Collective dynamics,Coupled oscillators,ER random network,Frequency fluctuation},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Collective dynamics of fractional oscillators with fluctuating frequency in Erdős-Rényi random networks},
   volume = {159},
   year = {2026}
}
@article{Chen2026,
   abstract = {This paper aims to investigate a novel fuzzy differential system, termed fuzzy fractional differential hemivariational inequalities. This system combines a Hilfer fractional fuzzy differential inclusion with a history-dependent hemivariational inequality, providing a unified framework for modeling complex dynamic processes. By utilizing the Banach fixed-point theorem and the Bohnenblust-Karlin fixed-point theorem, we establish the existence of solutions to the proposed problem. Finally, we demonstrate the applicability of our results by applying them to a frictional contact problem with thermal effects.},
   author = {Minghao Chen and Danfeng Wu},
   doi = {10.1016/j.cnsns.2026.109889},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Frictional contact problem,Fuzzy differential inclusions,Hemivariational inequality,Hilfer fractional derivative,History-dependent operator},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A new class of Hilfer fractional fuzzy differential inclusions driven by dynamic history-dependent hemivariational inequalities with application},
   volume = {159},
   year = {2026}
}
@article{Sultan2026,
   abstract = {We present a robust numerical framework for solving singularly perturbed partial differential equations with interior turning points. Such problems exhibit sharp boundary layers and steep gradients, and may also feature interior transition layers arising from turning points in the convective field, all of which pose significant challenges for conventional numerical methods. To address these difficulties, we develop a hybrid scheme that combines backward Euler time discretization with a semi-implicit semi-Lagrangian approach for advection and central differencing for diffusion. The semi-Lagrangian step follows characteristics of the advection coefficient, ensuring robustness for advection-dominated flows without stringent CFL limits, while the central diffusion step supplies controlled smoothing. A blended Péclet- and gradient-aware moving mesh density function adaptively concentrates nodes near boundary layers, interior transition layers, and outflow fronts, thereby maintaining accuracy and stability uniformly as diffusion tends to zero. Extensive numerical experiments, including problems with nonlocal convection, demonstrate the convergence and the efficiency of the uniform scheme in resolving both boundary and interior layers with minimal computational overhead. This work extends the relatively unexplored class of moving mesh semi-implicit semi-Lagrangian methods, providing new insights into the numerical treatment of singularly perturbed problems with general layer structures.},
   author = {Saad Sultan and Jianping Zhao},
   doi = {10.1016/j.cnsns.2026.109896},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Interior turning point problems,Semi-Lagrangian adaptive meshing,Uniform error estimates},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Semi-Lagrangian adaptive mesh method for singularly perturbed differential equation with interior turning point},
   volume = {159},
   year = {2026}
}
@article{Chen2026,
   abstract = {This paper studies the stability of traveling wavefronts for the viscous Nicholson’s blowflies equation. We prove that all noncritical traveling wavefronts (with wave speed greater than the minimum speed) are globally exponentially stable, while critical traveling wavefronts (with wave speed equal to the minimum speed) are globally algebraically stable. Our approach builds upon the weighted energy method by combining the fundamental solution theory for delay equations with the Fourier transform.},
   author = {Haomeng Chen},
   doi = {10.1016/j.cnsns.2026.109917},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Nicholson’s blowflies equation,Pseudo-parabolic equation,Stability,Traveling waves},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Stability of traveling wavefronts for viscous Nicholson’s blowflies equation},
   volume = {159},
   year = {2026}
}
@article{Conte2026,
   abstract = {We derive new classes of linearly implicit for systems of stochastic differential equations (SDEs) by employing the so-called Time-Accurate and highly-Stable Explicit (TASE) operators, introduced in the context of deterministic evolutive problems, in order to stabilize explicit numerical methods. In particular, we provide the TASE-based version of Euler-Maruyama method and some explicit stochastic Runge-Kutta methods for SDEs. Mean-square stability of TASE-based methods is analyzed and classes of mean-square A-stable methods are provided. A selection of numerical tests is reported, confirming the theoretical inspection.},
   author = {Dajana Conte and Raffaele D’Ambrosio and Alessia Montano and Beatrice Paternoster},
   doi = {10.1016/j.cnsns.2026.109883},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Mean-square A-stability,Stiff SDEs,Stochastic Runge-Kutta methods,TASE operators},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Stabilization of stochastic Runge-Kutta methods by TASE operators},
   volume = {159},
   year = {2026}
}
@article{Vallarino2026,
   abstract = {This paper develops a nonlinear evolution framework for modeling survival dynamics on weighted economic networks by coupling graph-based p –Laplacian diffusion with a stochastically driven reaction (hazard) mechanism. The resulting finite-dimensional PDE–SDE system describes node-level dynamics on a graph jointly with an aggregate structural variable evolving as an Itô diffusion. Using accretive operator theory, nonlinear semigroup methods, and stochastic analysis, we establish existence and uniqueness of mild solutions and characterize regimes of global dissipativity. A central contribution is the identification of a sharp spectral threshold separating globally stable dynamics from amplification-dominated regimes when the reaction operator loses monotonicity. This threshold links nonlinear diffusion strength to network spectral properties, showing how degree heterogeneity and topological concentration can undermine dissipativity even under bounded stochastic forcing. Numerical experiments on Barabási–Albert scale-free networks illustrate hub-driven amplification, rapid growth, and heavy-tailed cross-sectional profiles. The framework provides a rigorous analytical basis for nonlinear diffusion–reaction processes with stochastic forcing on heterogeneous economic and financial networks and connects graph-based evolution models with recent results on nonlinear lattice systems with noise.},
   author = {Diego Vallarino},
   doi = {10.1016/j.cnsns.2026.109904},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Graph p–Laplacian,Network economics,Nonlinear diffusion,PDE–SDE Systems,Stochastic dynamics},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Stochastic network survival dynamics: A nonlinear evolution problem on economic graphs},
   volume = {159},
   year = {2026}
}
@article{Khairullin2026,
   abstract = {Physics-informed neural networks (PINNs) often struggle with one-dimensional wave scattering as the Helmholtz residual pushes the solution toward fast oscillations. This study reformulates the problem through a pair of decoupled first-order equations and learns the ratio of forward and backward wave amplitudes, enforcing transparent boundaries with a hard constraint while recovering phase information by quadrature. For several representative complex permittivity profiles, the resulting “Lie generator” PINN lowers the mean absolute error by up to an order of magnitude and trains about three times faster than a Helmholtz PINN. The focus is on advancing PINNs with stronger physical structure rather than on surpassing classical solvers such as the transfer-matrix method.},
   author = {Bari Khairullin and Sergey Rykovanov},
   doi = {10.1016/j.cnsns.2026.109926},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Helmholtz equation,Nonlinear dynamics,Physics-informed neural network,Wave scattering},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Structure-Preserving helmholtz PINNs for absorbing media with transparent boundaries},
   volume = {159},
   year = {2026}
}
@article{Zhou2026,
   abstract = {To address the path following problem of the underactuated surface vessel in the presence of actuator fault and limited signal transmission bandwidth, a synchronous event-triggered fault-tolerant control strategy is proposed. In this study, an acceleration function is first introduced to correct the kinematic error, enabling it to converge rapidly even when actuator fault occurs. Subsequently, robust neural damping techniques are employed to handle parameter biases and model uncertainties, achieving dual compensation for actuator fault. Furthermore, a synchronous event-triggered control (SETC) is proposed, which can simultaneously activate the controller and the gain-related adaptive laws. This method not only guarantees tracking accuracy but also significantly reduces signal transmission frequency. Stability analysis based on Lyapunov theory proves that the closed-loop control system is semi-global uniform ultimate bounded (SGUUB) under all state errors. Finally, the effectiveness and superiority of the proposed control algorithm are illustrated through two numerical examples.},
   author = {Kailu Zhou and Chenfeng Huang and Kaiyue Zhou and Qianfeng Jing and Guobao Gong},
   doi = {10.1016/j.cnsns.2026.109853},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Actuator fault,Path following control,Synchronous event-triggered control,Underactuated surface vessel},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Synchronous event-triggered path following control for underactuated surface vessels with actuator fault},
   volume = {159},
   year = {2026}
}
@article{Luo2026,
   abstract = {This paper establishes three local conservation laws (mass, momentum, and energy) for the generalized Benjamin-Bona-Mahony-Korteweg-de Vries (GBBM-KdV) equation. These conservation laws provide deeper insights into the fundamental properties of the system, as they hold independently of boundary conditions. To inherit these properties discretely, we construct two novel local structure-preserving schemes by combining the Average Vector Field (AVF) method with the concatenating method discretization: a local energy-conserving scheme (LECS) and a local momentum-conserving scheme (LMCS). By employing the discrete Leibniz rule and operator theory, we rigorously prove that both schemes preserve the corresponding local conservation laws in arbitrary space-time regions, along with local mass conservation. Under periodic or homogeneous boundary conditions, the schemes also exhibit global conservation properties. We also provide a convergence and stability analysis for the numerical solutions. Numerical experiments confirm the theoretical analysis and demonstrate that the proposed schemes achieve superior accuracy in numerical solution errors compared to existing methods [1, 2]. Notably, the proposed schemes exhibit superior preservation of local conservation laws under non-periodic and inhomogeneous boundary conditions.},
   author = {Fangwen Luo and Qiong Tang},
   doi = {10.1016/j.cnsns.2026.109915},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Convergence analysis,,Energy conservation,GBBM-KdV equation,Mass conservation,Momentum conservation},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Two new local structure-preserving schemes for the GBBM-KdV equation},
   volume = {159},
   year = {2026}
}
@article{Wang2026,
   abstract = {In this paper, we present two Uzawa algorithms for the mixed steady Navier-Stokes-Darcy model. The first algorithm is the classical Uzawa method and the second improves the first by combining a grad-div stability term. Both algorithms can decouple pressure from the equations and do not need to solve a saddle point system at each iteration step. Theoretical analysis shows that our algorithms are convergent under a small data assumption. Several numerical experiments are conducted to show the accuracy of our methods.},
   author = {Qingzhou Wang and Guangzhi Du},
   doi = {10.1016/j.cnsns.2026.109920},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Finite element method,Grad-div stabilization,Navier-Stokes-Darcy model,Uzawa algorithm},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Two Uzawa algorithms for the steady Navier-Stokes-Darcy model},
   volume = {159},
   year = {2026}
}
@article{Chen2026,
   abstract = {In this paper, we investigate the stability of delayed impulsive control for stochastic complex networks (SCNs) with unbounded delays under cyber attacks. This paper considers the issue of unbounded delays in complex networks, assuming that the system may be subjected to deception attacks. By integrating the Lyapunov-Razuminkhin method with graph theory, several criteria for achieving p th-moment exponentially stable of the system are derived through the construction of delay impulsive control. Notably, our approach permits the delay impulsive control to be unbounded. Finally, we consider a single-link robot arms systems and some numerical simulations are presented to verify the validity of our results.},
   author = {Zanbo Chen and Xinyi Zheng and Xin Zhao},
   doi = {10.1016/j.cnsns.2026.109861},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Deception attacks,Delayed impulsive control,Stochastic complex networks,Unbounded delays},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Unbounded delayed impulsive control for the stability of stochastic complex networks with unbounded time delays under cyber attacks},
   volume = {159},
   year = {2026}
}
@article{Vanni2026,
   abstract = {We model human mobility as a combinatorial allocation process, treating trips as distinguishable balls assigned to location-bins and generating origin–destination (OD) networks. From this analogy, we construct a unified three-scale framework, enumerative, probabilistic, and continuum graphon ensembles, and prove a renormalization theorem showing that, in the large sparse regime, these representations converge to a universal mixed-Poisson law. The framework yields compact formulas for key mobility observables, including destination occupancy, vacancy of unvisited sites, coverage (a stopping-time extension of the coupon collector problem), and overflow beyond finite capacities. A key contribution is the explicit and testable treatment of cross-scale consistency in OD modeling. Numerical simulations with gravity-like kernels, calibrated on empirical OD data, closely match the asymptotic predictions. By connecting exact combinatorial models with continuum analysis, the results offer a principled toolkit for synthetic network generation, congestion assessment, and the design of sustainable urban mobility policies.},
   author = {Fabio Vanni and David Lambert},
   doi = {10.1016/j.cnsns.2026.109894},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Balls-into-bins models,Human mobility modeling,Inhomogenous random graphs with latent variables,Occupancy and load problems,Origin-destination networks},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Urn modeling of random graphs across granularity scales: A framework for origin-destination human mobility networks},
   volume = {159},
   year = {2026}
}
@article{Zhu2026,
   abstract = {In this study, a backward differentiation formula coupled with an interface-unfitted finite element method is presented to resolve parabolic interface problems. The well-known stable generalized finite element method (SGFEM) is employed to discretize the spatial variable, and a classical second-order backward differentiation formula (BDF2) is used for the time discretization. The proposed numerical method exhibits unconditional stability and attains an optimal L 2 error estimate without time-step restrictions. The optimal convergence rate in the L 2 norm has been confirmed by several numerical tests. The numerical results reveal that the proposed method exhibits unconditional stability even when a larger time step size is selected.},
   author = {Pengfei Zhu and Kai Liu and Linghua Kong},
   doi = {10.1016/j.cnsns.2026.109879},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {BDF2,L2 error estimate,Parabolic interface problem,SGFEM,Unconditional stability},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Unconditional stability and convergence of second-order backward differentiation formula in SGFEM for parabolic interface problems},
   volume = {159},
   year = {2026}
}
@article{Yavich2026,
   abstract = {Long- and short-wave radiative forcings are known to be critical components of numerical weather prediction models. Yet the respective parameterizations are notoriously computationally intensive because they are solving integro-differential equations describing radiation transfer and scattering over the wide band of wavelengths. As an alternative, they can be emulated using machine learning regression models. Based on physical motivations, we propose a Rapid Radiative Transfer Neural Network (RRTNN), a fast and accurate deep learning approach to emulate multiple radiative transfer and scattering processes. We evaluate its quality and practical applicability against competing methods using atmospheric data modeled within an Arctic region. Remarkably, we outperformed previous machine learning based radiation parameterizations. Finally, we assess the performance of the trained neural network in a downstream task by incorporating it into the Weather Research and Forecasting (WRF) Model Our approach yields a 26.5x speedup for radiation-related computations and a 1.5x speedup for the entire forecasting model. The proposed approach significantly reduces the computational burden demonstrating its potential for sustainable and efficient modeling.},
   author = {Nikolay Yavich and Stefan Maria Ailuro and Aleksey Chesnokov and Alexander Gavrikov and Evgeny Burnaev and Vladimir Vanovskiy},
   doi = {10.1016/j.cnsns.2026.109840},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Deep learning,Neural ODEs,Numerical weather prediction,Radiation parameterization},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Rapid radiative transfer neural network for weather forecasting acceleration},
   volume = {159},
   year = {2026}
}
@article{Liu2026,
   abstract = {In this paper, we analyze the weak Galerkin discretization with boundary value correction of the Poisson problem on fitted and unfitted polygonal meshes, and we establish the optimal convergence rate in both the energy norm and L 2 norm of any order, which can be achieved by using a suitable correction depending on high order directional derivatives of the discrete solution at the boundary edges within the actual polygonal computation area. To validate the theoretical results, we present numerical results in the final section.},
   author = {Yi Liu and Yongli Hou and Yanqiu Wang},
   doi = {10.1016/j.cnsns.2026.109902},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Boundary value correction,Curved domain,Optimal convergence,Polygonal mesh,Weak Galerkin method},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Weak Galerkin method with boundary value correction},
   volume = {159},
   year = {2026}
}
@article{Lima2026,
   abstract = {This work investigates impacting hybrid systems near a regular grazing point of order 2 k ( k ≥ 2, k∈N). We construct the Zero Discontinuity Mapping ( ZDM ) and Poincaré Discontinuity Mapping ( PDM ) in the neighborhood of such grazing points, providing high-order grazing corrections to the flow and capturing the leading-order singular behaviour of the system. These maps generalize previous results for second-order grazing points and allow precise characterization of bifurcations of periodic orbits, including the emergence of multiple small-amplitude limit cycles. Analytical expressions are derived for arbitrary even-order grazing points, and their dominant asymptotic terms are summarized, offering insight into the local dynamics of nonsmooth hybrid systems. The proposed framework enhances the predictive capability of discontinuity-induced bifurcation analysis and can be applied to a wide range of mechanical and electrical impact systems.},
   author = {Maurício Firmino Silva Lima and Tiago Rodrigo Perdigão},
   doi = {10.1016/j.cnsns.2026.109899},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Impacting hybrid system,Poincaré discontinuity mapping (PDM),Regular grazing point,Zero-time discontinuity mapping (ZDM)},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Zero time discontinuity mapping (ZDM) and Poincaré discontinuity mapping (PDM) in a neighborhood of a regular grazing point of order 2k,k≥2,k∈N in impacting hybrid systems},
   volume = {159},
   year = {2026}
}
@article{Huong2026,
   abstract = {This paper investigates a class of Caputo stochastic fractional differential equations of order α∈(12,1) in Lp spaces for p ≥ 2. These equations are distinguished by doubly singular kernels, the drift and diffusion coefficients satisfy a standard Lipschitz condition but also incorporate weakly singular terms of the form t−β1 and t−β2, respectively, subject to the constraints 0 ≤ β 1 < α and 0≤β2<α−12. The primary contributions of this work are the establishment of the existence and uniqueness of solutions. We then demonstrate the continuous dependence of solutions on the initial data and on the system parameters, namely the fractional order α and the singularity orders β=(β1,β2). Subsequently, the temporal regularity of the solutions is analyzed, followed by an investigation into the asymptotic separation between distinct solutions. The analysis relies on a suitable weighted norm, properties of the exponential and Beta functions, the Hölder inequality, and the Burkholder-Davis-Gundy inequality. A crucial component of our methodology involves strategic transformations of integrals to effectively manage the challenges posed by doubly singular kernels.},
   author = {P. T. Huong and N. N. Thang and P. T. Anh},
   doi = {10.1016/j.cnsns.2026.109885},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Asymptotic separation between solutions,Doubly singular kernels,Stochastic fractional differential equations,Well-posedness},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Well-posedness and asymptotic separation between solutions of stochastic fractional differential equations with doubly singular kernels},
   volume = {159},
   year = {2026}
}
@article{Bensoam2026,
   abstract = {A variety of engineering problems require a robust numerical framework for modeling fabrics. In this article, Cartan’s method of moving frames is used to design variational integration techniques for fabrics, modeling the fabric as an inextensible surface, free of any normal stress, that is subject to the influence of gravity. In addition, we use Noether’s theorem to derive the invariant quantities (i.e., Noether currents) associated with the symmetries of the fabric. It is shown that these invariants correspond to the extension of the well-known Young-Laplace law in presence of gravity. The theory is applied to design two types of integrators: (i) a semi-analytic integrator is proposed for axisymmetric boundary value problems, and (ii) a general covariant multisymplectic integrator is derived. Unlike the existing works on multisymplectic integrators, the proposed integrators address the non-separability of the Lagrangian energy functional with respect to the two independent variables. Finally, numerical simulations are used to validate our findings.},
   author = {Joël Bensoam and Shiraz Khan and Gregory S. Chirikjian},
   doi = {10.1016/j.cnsns.2026.109852},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Differential geometry,Fabric model,Mechanics,Variational integrators},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A discrete multisymplectic fabric model},
   volume = {159},
   year = {2026}
}
@article{BeltrndelaFlor2026,
   abstract = {Multiplicatively separable solutions of the Novikov equation are investigated. The separation ansatz reduces the equation to a decoupled pair of ordinary differential equations for the temporal and spatial factors, and the corresponding initial value problems (IVPs) are analysed. The temporal IVP and the degenerate regimes of the spatial IVP admit elementary solutions, whereas the nondegenerate spatial IVP presents the main difficulty: the reduced spatial equation is third order and its Lie point symmetry algebra is isomorphic to the non–solvable Lie algebra sl(2,R), placing it outside standard integration by quadratures. To overcome this obstruction, integration techniques developed for SL(2,R)–invariant third–order equations are employed, leading to an explicit parametric representation of the unique IVP solution in terms of Bessel or modified Bessel functions. These results yield a complete classification of all multiplicatively separable solutions of the Novikov equation. Several model examples illustrate the dependence of maximal domains and endpoint behaviour on the Cauchy data, and previously reported separable solutions are placed within the present classification framework.},
   author = {Beltrán de la Flor and Adrián Ruiz and Concepción Muriel},
   doi = {10.1016/j.cnsns.2026.109835},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Novikov equation,SL(2,R)–invariant ODEs,Separated–variables solutions},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Complete classification of multiplicatively separable solutions to the Novikov equation},
   volume = {159},
   year = {2026}
}
@article{Wang2026,
   abstract = {In this paper, we investigate the spatiotemporal dynamics of a synthetic paradoxical cell population control circuit by formulating a delayed reaction–diffusion model that accounts for diffusive auxin transport and an intrinsic delay in blasticidin-mediated killing. Moving beyond well-mixed temporal descriptions, we linearize the system at the spatially homogeneous equilibrium and decompose perturbations into Neumann eigenmodes of the Laplacian, which yields a mode-dependent characteristic equation parameterized by the wavenumber. For each spatial mode, we derive explicit Hopf bifurcation conditions and, under a sufficient nondegeneracy condition that ensures a single Hopf pair for a given mode, obtain closed-form expressions for the Hopf frequency and the corresponding critical delay. We define the primary instability threshold as the minimal critical delay across all modes, which provides a principled mode-selection criterion. Under the baseline parameter set, numerical simulations show that instability first occurs through a homogeneous mode, leading to synchronized population oscillations. The predicted threshold for the first inhomogeneous mode, together with targeted simulations, further indicates that sufficiently large delays can support persistent standing-wave oscillations. These results quantify how delay–diffusion coupling reshapes the stability spectrum and provide design-relevant guidelines for deploying paradoxical population controllers in spatially distributed environments.},
   author = {Conghua Wang and Yunfeng Zhang and Yaomin Nie},
   doi = {10.1016/j.cnsns.2026.109937},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Paradoxical circuit,Reaction-diffusion,Spatiotemporal pattern,Synthetic biology,Time delay},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Delay-diffusion induced mode-selective Hopf bifurcations in a paradoxical cell population control circuit},
   volume = {159},
   year = {2026}
}
@article{Xie2026,
   abstract = {This article investigates the composite adaptive pitch angle control problem for variable speed wind turbines (VSWTs) with guaranteed transient performance in the presence of external disturbances. To enhance the tracking performance of wind turbine systems, a novel finite-time prescribed performance function (FTPPF) is constructed with the key advantage of allowing flexible presetting of the time required to attain the specified steady-state boundary. By introducing the transformation error and filtering error, a finite-time prescribed performance pitch angle controller is systematically developed to ensure that the system performance including settling time, steady-state error, and maximum overshoot can be precisely adjusted. Moreover, the fuzzy logic system (FLS) can effectively approximate the unknown nonlinear functions of the wind turbine system, while the designed composite adaptive laws compensate for the unknown nonlinearities, approximation errors, and external disturbances. Contrastive simulations are carried out on a 1.5-MW three-blade wind turbine to verify the feasibility and superiority of the presented controller.},
   author = {Shuzong Xie and Huihui Shi and Xuguo Jiao and Beiping Hou and Jianwei Dong},
   doi = {10.1016/j.cnsns.2026.109864},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Composite adaptive control,Finite-time prescribed performance function,Pitch angle control,Variable speed wind turbines},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Composite adaptive pitch angle control for VSWTs with guaranteed transient performance},
   volume = {159},
   year = {2026}
}
@article{Li2026,
   abstract = {In this paper, we propose a new piecewise neural network realizing learnable Fourier features on each subnetwork to tackle elliptic and parabolic interface problems with discontinuous coefficient varying on curved surfaces. To obtain an approximate solution with discontinuity across the interface, we use the domain decomposition approach that trains multiple subnetworks simultaneously, which approximate the solution in a subdomain divided by the sharp interface. Utilizing the level-set function, the surface differential operators have been reworked in terms of classical Cartesian differential operators. In order to enhance the accuracy, we inject the piecewise learnable Fourier features into the input of neural networks for each subnetwork to help converge high-frequency components. Interestingly enough, no research exists into how one would go about formulating machine learning methods to solve parabolic interface problems on curved surfaces. Some numerical experiments including one with an evolving surface are carried out to check the accuracy and efficiency of the proposed neural network architecture with Fourier features.},
   author = {Hongji Li and Zhijun Tan},
   doi = {10.1016/j.cnsns.2026.109914},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Domain decomposition method,Fourier features,Interface problem,Neural network,Surface PDEs},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A piecewise Fourier-feature-based neural network for elliptic and parabolic interface problems on curved surfaces},
   volume = {159},
   year = {2026}
}
@article{Wang2026,
   abstract = {Image inpainting aims to restore the structure and texture of damaged areas, and plays an important role in cultural heritage preservation, medical imaging and film production. However, it is still a challenge for existing methods to balance restoration effectiveness and computational cost. Inspired by ecological dynamics, this paper introduces a predator-prey model into image inpainting. Using population evolution characteristics, it provides a novel perspective on the information evolution between damaged and undamaged regions. In addition, this method also incorporates the reaction-diffusion mechanism, which can effectively smooth details. Numerical experiments show that this method can successfully remove scratches, noise, and text occlusion. Furthermore, it is applicable not only to grayscale images but also extends to color images. Compared to other methods, we significantly reduce the required time while maintaining high-quality restoration results. This research provides an efficient and novel solution for image inpainting, and effectively achieves a balance between restoration quality and computational cost.},
   author = {Jian Wang and Mengyu Luo and Junseok Kim},
   doi = {10.1016/j.cnsns.2026.109906},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Image inpainting,Predator-prey model,Reaction-diffusion},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {A practical image inpainting algorithm based on a predator-prey model},
   volume = {159},
   year = {2026}
}
@article{Sun2026,
   abstract = {In this paper, we study the stabilization of nonlinear delayed systems via event-triggered delayed impulsive control strategy. A novel approach is given for the design of event-triggered mechanism (ETM). Based on the developed data transmission mechanism and utilizing the Lyapunov stability method, a set of delayed impulsive control is designed to guarantee global uniform asymptotic stability of the system. It is noteworthy that in our result impulsive delay can vary within an arbitrarily bounded range, even beyond the event intervals, which is different from the existing works. Moreover, the proposed strategy is further applied to the synchronization of complex networks. It is proven that delayed impulsive control only needs to be implemented on a portion of nodes using above event-triggered manner, then the dynamics of all network nodes can exponentially converge to the desired trajectory. Finally, the validity of our main results is confirmed by two numerical examples.},
   author = {Yuhan Sun and Jianquan Lu and Mengping Xing and Qihua Ruan and Jungang Lou},
   doi = {10.1016/j.cnsns.2026.109862},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Delayed impulsive control,Event-triggered mechanism,Global uniform asymptotic stability,Synchronization},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Event-triggered impulsive stabilization of nonlinear delayed systems with application to network synchronization},
   volume = {159},
   year = {2026}
}
@article{K2026,
   abstract = {We investigate signal transmission in a network of unidirectionally coupled plasma oscillators, where only the first oscillator is driven by a weak periodic input. As the signal propagates through the network, nonlinear interactions generate higher-order harmonic components. Spectral analysis identifies five distinct transmission patterns for the fundamental frequency and odd harmonics, and four patterns for even harmonics, encompassing damped propagation, undamped transmission, and localized amplification. The transmission characteristics are governed by both the coupling strength and system parameters. Furthermore, we analyze how variations in these key parameters shape the overall signal dynamics.},
   author = {Abirami K․ and Miguel A. Prado-Reynoso and Miguel A.F. Sanjuán},
   doi = {10.1016/j.cnsns.2026.109865},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Coupled plasma networks,Higher harmonic generation,Nonlinear resonance,Signal transmission},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Energy transmission and harmonic propagation in unidirectionally coupled plasma oscillator networks},
   volume = {159},
   year = {2026}
}
@article{Olenin2026,
   abstract = {Extreme events are a prominent phenomenon in nonlinear and complex systems, with far-reaching implications across disciplines due to their potential to trigger catastrophic transitions and drastically alter system dynamics. In neuroscience, one of the most critical manifestations of extreme events is epileptic seizures, whose unpredictable onset poses significant challenges for diagnosis and treatment. Understanding the underlying mechanisms of extreme event generation is thus crucial for improving predictability and control in neural systems. In this work, we investigate how subtle coupling mechanisms, specifically, interaction through a common external field, can induce the emergence of extreme and even super-extreme events in small ensembles of excitable neurons. Using a two-parameter bifurcation analysis, we systematically explore the routes to the birth and collapse of such events in a network of FitzHugh–Nagumo neurons coupled via both chemical and memristive synapses. We demonstrate that extreme events arise through the formation of a spiral chaotic attractor via an Afraimovich–Shilnikov homoclinic bifurcation, following the classical Shilnikov scenario. This transition is further validated through experimental simulations on the Simulink platform, confirming the robustness and physical plausibility of the observed dynamics. Our findings highlight the critical role of nonconventional coupling in triggering pathological-like bursts in neural networks, offering new insights into the dynamical origins of seizure-like events and potential strategies for their anticipation.},
   author = {Sergey M. Olenin and Alexander G. Korotkov and Ivan M. Kipelkin and Svetlana A. Gerasimova and Tatiana A. Levanova and Alexander N. Pisarchik},
   doi = {10.1016/j.cnsns.2026.109841},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Extreme events,FitzHugh–Nagumo system,Memristive synapse,Shilnikov bifurcation,Super extreme events},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Emergence of extreme and super-extreme events in coupled neural ensembles via field-mediated interactions},
   volume = {159},
   year = {2026}
}
@article{Joli2026,
   abstract = {In this study, we address a terminal control problem for processes governed by a nonlinear system of fractional ordinary differential equations. To establish the existence of control for this nonlinear system, we first examine its linear counterpart, extending several classical control theory results to the fractional context. Specifically, we derive a solution representation using a Gramian-type matrix, validate Kalman’s principle, and demonstrate the equivalence of controllability and observability in the fractional setting. From the linear case, we proceed by applying a fixed-point theorem and integrating various techniques from fractional calculus to obtain results that extend to the nonlinear system. Additionally, we provide numerical examples inspired by medical applications, particularly in cardiology, to illustrate the theoretical results.},
   author = {Maja Jolić and Sanja Konjik and Darko Mitrović and Andrej Novak},
   doi = {10.1016/j.cnsns.2026.109918},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Adjoint system,Caputo fractional derivative,Controllability,Diagonalization,Electrophysiology,Fixed point,Kalman’s rank condition,Mittag-Leffler function,Observability,Peano-Baker series},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Exact controllability of nonlinear fractional systems with potential applications in cardiac electrophysiology},
   volume = {159},
   year = {2026}
}
@article{Chen2026,
   abstract = {This study addresses the fixed-time synchronization in delayed inertial neural networks through a hybrid control framework combining continuous fixed-time law that avoids chattering with the pinning impulsive controller. Unlike conventional settling time estimation approaches, the proposed impulse-dependent estimation method yields less conservative fixed-time settling time. Furthermore, a pinning control technique is employed, dynamically adjusting pinned neurons at each impulsive instant based on distinct criteria such as random selection or distance-based strategies. This can enhance control efficiency by dynamically controlling certain neurons. By integrating these rules with Lyapunov stability theory, we establish sufficient synchronization criteria for delayed inertial neural networks. Numerical simulations demonstrate that distance-based pinning strategies achieve superior performance compared to random selection methods, and visually corroborate that the settling time decreases as the number of impulses increases.},
   author = {Tao Chen and Shiguo Peng and Zhiwen Fu and Ruitao Huang and Guizhen Mai},
   doi = {10.1016/j.cnsns.2026.109848},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Delayed inertial neural networks,Fixed-time synchronization,Impulse-dependent settling-time estimation,Pinning impulsive control},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Fixed-time synchronization of delayed inertial neural networks with impulsive control via two pinning rules},
   volume = {159},
   year = {2026}
}
@article{Zhou2026,
   abstract = {This work focuses on the trajectory tracking control of quadrotor unmanned aerial vehicle (QUAV) subject to simultaneous external disturbances and multiple actuator faults. By analyzing the dynamic characteristics of the QUAV, a more practical fault dynamic model is established in this paper. A novel fixed-time fractional-order sliding mode fault-tolerant controller is developed to guarantee that the system error converges within a fixed time upper bound. To address the co-existence of frequent actuator failures and external disturbances, a phase-specific parameter decoupling mechanism is proposed, and a fractional-order adaptive law is incorporated, significantly enhancing the smoothness of system convergence and flexibility of parameter adjustment. Furthermore, an innovative fixed-time reaching law with an inverse trigonometric power exponent is proposed, substantially accelerating the convergence rate. Theoretical analysis and comprehensive simulation studies demonstrate that the presented control algorithm ensures satisfactory tracking performance for the QUAV even under simultaneous external disturbances and actuator faults.},
   author = {Zhen Zhou and Hai Yang Yu and Yu Chen Liu},
   doi = {10.1016/j.cnsns.2026.109884},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Adaptive control,Fault-tolerant control,Fixed-time sliding mode control,Fractional order},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Fractional-order adaptive fixed-time fault-tolerant control for quadrotor unmanned aerial vehicle},
   volume = {159},
   year = {2026}
}
@article{Bhar2026,
   abstract = {In this article, we have analyzed the full discretization of the stochastic semilinear Schrödinger equation in a bounded convex polygonal domain driven by multiplicative Wiener noise. We use the finite element method for spatial discretization and the stochastic trigonometric method for time discretization and derive a strong convergence rate with respect to both parameters (temporal and spatial). Numerical experiments have also been performed to support theoretical bounds.},
   author = {Suprio Bhar and Mrinmay Biswas and Mangala Prasad},
   doi = {10.1016/j.cnsns.2026.109921},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Finite element method,Multiplicative noise,Stochastic semilinear Schrödinger equation,Strong convergence,Wiener process},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Full discretization of stochastic semilinear Schrödinger equation driven by multiplicative Wiener noise},
   volume = {159},
   year = {2026}
}
@article{Xue2026,
   abstract = {Conservative nonlinear evolution equations play a fundamental role in various scientific and engineering fields, including water wave theory, nonlinear optics, and quantum mechanics. Developing efficient structure-preserving numerical schemes is therefore essential for accurately capturing the long-time dynamics of such systems. This study focuses on conservative nonlinear evolution equations and proposes a novel class of linearly implicit structure-preserving schemes by combining the Lagrange multiplier approach with implicit-explicit Runge–Kutta methods. The proposed framework possesses several distinctive advantages. First, it preserves multiple higher-order invariants while overcoming a limitation of the classical projection method, namely its inability to maintain linear invariants. Second, once the Lagrange multipliers are determined, the resulting schemes remain linearly implicit. Third, the proposed framework can achieve arbitrarily high-order temporal accuracy. Extensive numerical experiments demonstrate the effectiveness of the proposed methods, corroborate the theoretical analysis, and confirm their superior stability and robustness in long-time simulations.},
   author = {Lianpeng Xue and Wansheng Wang and Qifeng Zhang},
   doi = {10.1016/j.cnsns.2026.109878},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Conservative nonlinear evolution equations,Implicit-explicit Runge–Kutta methods,Invariant,Lagrange multiplier approach,Long time simulation},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {High-order structure-preserving implicit-explicit Runge–Kutta methods with Lagrange multiplier approach for conservative nonlinear evolution equations},
   volume = {159},
   year = {2026}
}
@article{Maji2026,
   abstract = {To understand the dynamics of Alzheimer’s disease, we consider a mathematical model based on the aggregation of disease-related proteins, activation of immune cells and initiation of inflammation. We investigate the basic properties of the model, such as the determination of equilibrium points, local and global stability analysis. Local and global sensitivity analyses are conducted to understand the complex behavior of the proposed model. Local sensitivity analysis is carried out using one-at-a-time (OAT) perturbation method, semi-relative and logarithmic sensitivity approaches, while the global sensitivity is performed using Latin Hypercube Sampling (LHS) combined with Rank Correlation Coefficient (RCC) and Partial Rank Correlation Coefficient (PRCC) methods. Summarized sensitivity tables are presented to provide ranks of parameters, highlighting which have the most significant contribution to the overall disease dynamics. The sensitivity results show that some of the parameters have a strong impact on system behaviour, indicating their potential biological importance in influencing amyloid beta aggregation, tau aggregation and microglial activation, consistent with existing pathological evidence.},
   author = {Mitali Maji and Subhas Khajanchi},
   doi = {10.1016/j.cnsns.2026.109854},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Amyloid beta protein,Local and global,NFTs,Oligomers,Sensitivity},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Identifying key parameters in an Alzheimer’s model through comprehensive sensitivity analysis},
   volume = {159},
   year = {2026}
}
@article{Mendoza2026,
   abstract = {We consider the family of quadratic mappings Fa,b(x,y)=(−x(x+y)+a,x+b),a,b∈R, which arises in models of neural dynamics in the brain. Inspired by the classical Mandelbrot set, we define the set of parameter values (a, b) for which the orbit of the critical value remains bounded. This set exhibits fractal geometry and its boundary indicates the existence of homoclinic bifurcations. We prove the existence of a region in parameter space where F a,b behaves as a half-orientable horseshoe map , meaning that for any symbolic sequence s ∈ Σ2 different from ∞(10) w , there exists a compact rectangle R (s) whose itinerary under F a,b is s . Moreover, if the negative part of s is pre-periodic, then R (s) is a single point.},
   author = {Valentín Mendoza and Bráulio Garcia},
   doi = {10.1016/j.cnsns.2026.109892},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Fractal geometry,Half-orientable horseshoe,Quadratic family,Symbolic dynamics},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Fractal structures in the parameter plane of a quadratic family},
   volume = {159},
   year = {2026}
}
@article{Louakar2026,
   abstract = {In this paper, we study an iterative learning control strategy applied to Hilfer fractional impulsive systems subject to random trial lengths. The Hilfer operator introduces an additional degree of freedom by interpolating between the Liouville-Caputo and Riemann-Liouville definitions, making it particularly suitable for modeling memory and inheritance effects. The presence of both non-instantaneous impulses and randomly varying trial lengths allows for the representation of more realistic scenarios, where external interventions may last for a finite time and where trial execution may be interrupted unpredictably due to failures, disturbances, or communication outages. To address these challenges, we introduce a modified error formulation, inspired by the domain alignment based operator approach, to ensure efficient tracking performance in the presence of stochastic variations in trials. We establish the convergence properties of the proposed scheme and show, through numerical simulations on a robotic system, that the method enables accurate trajectory tracking in just a few iterations.},
   author = {Ayoub Louakar and Devaraj Vivek and Ahmed Kajouni and Khalid Hilal},
   doi = {10.1016/j.cnsns.2026.109882},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Hilfer fractional derivative,Iterative learning control,Non-instantaneous impulses,Randomly varying trial lengths,Robotic systems,Trajectory tracking},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Iterative learning control for Hilfer-type fractional stochastic systems with impulsive effects and random trial lengths},
   volume = {159},
   year = {2026}
}
@article{Chen2026,
   abstract = {Temporally-variant quadratic programming problem involving inequality constraints holds substantial significance across numerous practical applications. A multitude of studies have shown that zeroing neural network is a highly effective approach for tackling the challenging problem. However, existing zeroing neural network models confront two notable challenges. First, the approach for converting inequalities into equalities falls short of being fully effective. For instance, it may be continuous but not differentiable, and it often introduces additional variables or parameters that necessitate manual adjustment. Second, those models generally prioritize convergence while overlooking the importance of noise suppression. In this paper, a novel transform function that equivalently convert inequalities into equalities is proposed. This function is not only continuous and differentiable everywhere, but also avoids introducing any extraneous variables or parameters. Building on this foundation, an integration-enhanced zeroing neural network model is proposed. This model is designed to effectively address temporally-variant quadratic programming problems that involve inequality constraints, while simultaneously suppressing noise. The convergence and robustness of the proposed model are confirmed through comprehensive theoretical analyses. Extensive numerical experiments showcase that, despite the interference from various types of noise (i.e., zero, constant, temporally-variant linear, and bounded random noise), the proposed model remains highly effective in addressing the problem. Moreover, an application on a UR5 robotic arm further corroborates the applicability and effectiveness of the proposed integration-enhanced zeroing neural network model.},
   author = {Jielong Chen and Yan Pan and Yunong Zhang},
   doi = {10.1016/j.cnsns.2026.109851},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Temporally-variant quadratic programming,inequality constraints,noise suppression,zeroing neural network},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Integration-enhanced zeroing neural network for temporally-variant quadratic programming involving inequality constraints},
   volume = {159},
   year = {2026}
}
@article{Yao2026,
   abstract = {When the axisymmetric vectoring exhaust nozzle (AVEN) of an aircraft engine operates in a heavy load environment, wear between components causes an increase in the joint clearance of the mechanism, resulting in a decrease in life. A model updating method is proposed that combines material-level and principle-level experiments, and this model is incorporated into the dynamics model for predicting the wear and life of the AVEN mechanism. Initially, the accuracy of wear profile updating is validated. Subsequently, the proposed method is applied to update profiles and predict contact damage between the roller and bushing. Results demonstrate a transition in contact damage from classical linear degradation to exponential deterioration when wear is considered. Additionally, rotational speed and load pattern emerge as significant factors influencing joint profiles and damage.},
   author = {Sibo Yao and Zhong Luo and Hongwei Zhang and Chunyang Xu and Dongtao Xu and Tianyue Ma},
   doi = {10.1016/j.cnsns.2026.109941},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Axisymmetric vectoring exhaust nozzle,Damage prediction,Friction-wear experiment,Wear prediction},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Life prediction of axisymmetric vectoring exhaust nozzle based on friction-wear experiment},
   volume = {159},
   year = {2026}
}
@article{Otiniano2026,
   abstract = {Modeling multivariate extreme values in complex systems increasingly demands flexible distributions capable of capturing multimodal behavior. Classical bivariate extreme value (BEV) distributions, though well established, are inherently unimodal and may inadequately represent data with heterogeneity or regime-switching-features commonly observed in environmental and financial applications. This paper introduces the Multimodal Bivariate Extreme Value (MBEV) distribution, a new class that extends the traditional BEV framework to accommodate multimodal structures through additional shape parameters. Unlike previous generalizations restricted to specific cases such as the bivariate Gumbel model, the MBEV encompasses the entire BEV family. We explore theoretical properties of the MBEV model, including its stochastic representation and its connection to the bivariate Weibull distribution. Through Monte Carlo simulations, we assess the performance of maximum likelihood estimators and demonstrate their robustness. An application to climate data from Brasília, Brazil, illustrates the practical value of the MBEV model in capturing complex dependencies among extreme variables such as wind gust speed, relative humidity, and dew point temperature. Model selection criteria (AIC and BIC) confirm the superiority of the MBEV model over classical BEV distributions. Overall, the MBEV model offers a flexible and interpretable framework for modeling bivariate extremes, with potential applications in climatology, survival analysis, reliability, and finance. This work advances the frontier of extreme value modeling by addressing multimodal dependence in heterogeneous multivariate contexts.},
   author = {Cira E.G. Otiniano and Yasmin L.S. de Oliveira and Raul Matsushita and Thiago do R. Sousa},
   doi = {10.1016/j.cnsns.2026.109898},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {BEV distribution,BGEV distribution,MLE,Multimodality},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Modeling multimodal bivariate extreme values: Theory, estimation, and applications},
   volume = {159},
   year = {2026}
}
@article{Torri2026,
   abstract = {We introduce a model for the loss distribution of a credit portfolio considering a contagion mechanism for the default of names which is the result of two independent components: an infection attempt generated by defaulting entities and a failed defence from healthy ones. We then propose an efficient recursive algorithm for the loss distribution. Then we extend the framework with more flexible distributions that integrate a contagion component and a systematic factor to better fit real-world data. Finally, we propose an empirical application in which we price synthetic CDO tranches of the iTraxx index, finding a good fit for multiple tranches.},
   author = {Gabriele Torri and Rosella Giacometti and Gianluca Farina},
   doi = {10.1016/j.cnsns.2026.109886},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {CDO,Contagion,Infection,Portfolio loss distribution},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Modeling portfolio loss distribution under infectious defaults and immunization},
   volume = {159},
   year = {2026}
}
@article{Pu2026,
   abstract = {This work presents two efficient numerical schemes for the Cahn-Hilliard-Navier-Stokes (CHNS) model. The proposed method, termed the relaxation explicit-Invariant Energy Quadratization (R-EIEQ) scheme, enhances the standard EIEQ approach by integrating a relaxation technique. This novel construction not only preserves all the advantages of EIEQ-such as its linear, fully decoupled structure and unconditional energy stability-but also corrects errors in the auxiliary variables, ensuring consistency with the original energy law. We rigorously establish the unconditional energy stability for both numerical schemes and provide comprehensive details of their implementation, demonstrating that they possess a linear and fully decoupled structure. Through extensive numerical examples, the R-EIEQ algorithm is shown to possess better stability and higher accuracy than EIEQ, with its dynamic behavior further demonstrated in both two and three-dimensional settings.},
   author = {Jincheng Pu and Zijiang Luo and Fulin Mei and Jun Zhang},
   doi = {10.1016/j.cnsns.2026.109891},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Cahn-Hiliard equation,Decoupled,EIEQ,Navier-Stokes equation,Unconditionally energy stable},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Improving the accuracy and consistency of explicit-invariant energy quadratization method for Cahn-Hiliard-Navier-Stokes equations by relaxation method},
   volume = {159},
   year = {2026}
}
@article{B2026,
   abstract = {This paper addresses the problem of asymptotic stabilization of fractal-order nonlinear cyber-physical systems under deception attacks, employing a reinforcement learning based interval type-3 fuzzy feedback control strategy. Notably, the fractal-order systems exhibit self-similar, non-integer dynamics, making their behavior complex and difficult to model. Due to their intricate nature, many aspects of their mathematical foundation and real-world applications are still not fully understood. To mitigate the effects of deception attacks and improve system stability, a control strategy is proposed that integrates a non-parallel distributed compensation scheme with a reinforcement learning-based algorithm. To address the challenge of limited data for effective training, reinforcement learning is incorporated into the interval type-3 fuzzy feedback control, improving control performance despite data constraints. Utilizing Lyapunov stability theory, sufficient conditions ensuring the asymptotic stability of the system are derived in the form of linear matrix inequalities. Furthermore, the validity of the proposed approach is substantiated through two illustrative examples, including a practical example mass-spring-damper system, highlighting its practical applicability.},
   author = {Harikaran B and Harshavarthini S},
   doi = {10.1016/j.cnsns.2026.109850},
   issn = {10075704},
   journal = {Communications in Nonlinear Science and Numerical Simulation},
   keywords = {Cyber-physical system,Deception attack,Fractal-order,Interval type-3 fuzzy systems,Lyapunov stability theory,Reinforcement learning},
   month = {8},
   publisher = {Elsevier B.V.},
   title = {Learning-based type-3 fuzzy control for fractal-nonlinear cyber-physical systems},
   volume = {159},
   year = {2026}
}
