@article{ref_479837a7,
  title = {Physical_Interpretation_of_the_Curvature_of_the_Gradient_Richardson_Number_in_the_Stable_Atmospheric_Boundary_Layer},
  abstract = {The curvature of the gradient Richardson number Rig with respect to the Monin–Obukhov stability parameter ζ = z/L provides fundamental insight into the nonlinear coupling between stratification and turbulent mixing in the atmospheric surface layer. We derive a compact an- alytical expression for ∂2Rig/∂ζ2 in terms of logarithmic derivatives of the Monin–Obukhov stability functions ϕm and ϕh, introducing the neutral curvature invariant ∆= αhβh −2αmβm that governs the initial departure from linearity. We demonstrate that negative curvature (typ- ical in stable boundary layers) leads to systematic underestimation of near-surface stability on coarse vertical grids, producing excessive turbulent mixing. A grid-aware correction strategy preserving the neutral curvature 2∆is outlined, with implications for improved parameterization of stable nocturnal and polar boundary layers.},
  file = {refs/Physical_Interpretation_of_the_Curvature_of_the_Gradient_Richardson_Number_in_the_Stable_Atmospheric_Boundary_Layer.pdf},
}

