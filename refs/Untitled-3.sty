def curvature_correction(zeta, dz, Delta=-3.0, 
                         D=0.8, dz_ref=10, 
                         zeta_ref=0.5, q=2):
    """Neutral-preserving grid damping factor."""
    G = np.exp(-D * (dz/dz_ref) * (zeta/zeta_ref)**q)
    return G
\end{verbatim}
