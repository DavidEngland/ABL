\section{Closing}

\begin{frame}{Three Takeaways}
  \begin{enumerate}
    \item \textbf{Curvature matters:}\\
    $\Delta$ sets initial departure from neutrality;\\
    negative $\Delta \Rightarrow$ coarse-grid underestimation
    
    \vspace{0.3cm}
    \item \textbf{Geometric mean height:}\\
    Use $z_g = \sqrt{z_0 z_1}$ for layer diagnostics—\\
    it's the natural log-space center
    
    \vspace{0.3cm}
    \item \textbf{Neutral preservation:}\\
    Any correction \alert{must} keep $2\Delta$ intact;\\
    tail damping only
  \end{enumerate}
\end{frame}

