@article{EnglandMcNider1995BLM,
  author    = {England, D. E. and McNider, R. T.},
  title     = {Stability Functions Based upon Shear Functions},
  journal   = {Boundary-Layer Meteorology},
  volume    = {74},
  number    = {1--2},
  pages     = {113--130},
  year      = {1995},
  doi       = {10.1007/BF00715711},
  keywords  = {CURV, PARAM, foundational},
  note      = {[READ] Our foundational paper; derives f(Ri) from phi(zeta), introduces neutral curvature Delta.},
  annote    = {Derives Richardson number stability functions f_m(Ri), f_h(Ri) analytically from MOST phi functions via series inversion zeta(Ri). Introduces neutral curvature invariant Delta=alpha_h*beta_h - 2*alpha_m*beta_m governing quadratic Ri term. Shows cubic inversion for zeta(Ri) enables fast, iteration-free closures. Proves Pr_t=1 in SBL implies quadratic (not linear) f(Ri). Basis for current curvature-aware correction framework.}
}

@article{LiKatulBouZeid2012PoF,
  author    = {Li, D. and Katul, G. G. and Bou-Zeid, E.},
  title     = {Mean Velocity and Temperature Profiles in a Sheared Diabatic Turbulent Boundary Layer},
  journal   = {Physics of Fluids},
  volume    = {24},
  number    = {10},
  pages     = {105105},
  year      = {2012},
  doi       = {10.1063/1.4758476},
  keywords  = {MOST, SBL, theory},
  note      = {[SKIM] Extended MOST to finite Reynolds number; analytic profile solutions.},
  annote    = {Theoretical extension of MOST incorporating finite Reynolds number effects via matched asymptotic expansions. Provides closed-form solutions for mean profiles in diabatic conditions. Shows MOST emerges as leading-order limit; next-order corrections scale with z/delta. Useful for LES validation and understanding MOST breakdown aloft. Complex math; main takeaway is rigorous foundation for MOST applicability range.}
}

